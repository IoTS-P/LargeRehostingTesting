diff --git a/common/src/lib.rs b/common/src/lib.rs
index a5c5f28..8bfcb2e 100644
--- a/common/src/lib.rs
+++ b/common/src/lib.rs
@@ -15,5 +15,10 @@ pub use rustc_hash::FxHasher;
 pub type FxHashMap<K, V> = hashbrown::HashMap<K, V, BuildHasherDefault<rustc_hash::FxHasher>>;
 pub type FxHashSet<K> = hashbrown::HashSet<K, BuildHasherDefault<rustc_hash::FxHasher>>;
 
-pub const GIT_VERSION: &str = git_version::git_version!();
+// The upstream call is `git_version::git_version!()`, which makes the build fail when
+// `git describe` cannot run.  That happens in this artifact: the tool is a git submodule
+// and its `.git` file carries a gitdir path relative to the *host* layout, which does not
+// resolve under the container's /data/tools mount.  The fallback keeps the build working
+// and only changes the embedded version string.
+pub const GIT_VERSION: &str = git_version::git_version!(fallback = "unknown");
 pub const CONFIG: &str = include_str!("config.rs");
