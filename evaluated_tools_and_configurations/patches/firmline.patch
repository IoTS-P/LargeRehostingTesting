-        filename.rename(newname)
+        # Move the analysed file into the processed store.  The input handed to us may sit on
+        # a different filesystem than this checkout (in the containerised pipeline the akiba
+        # work directory and /data/tools are separate mounts), and rename(2) cannot cross
+        # devices: it fails with EXDEV and the whole run aborts after the analysis is already
+        # done.  Fall back to copy + unlink so the result is kept.
+        try:
+            filename.rename(newname)
+        except OSError as exc:
+            if exc.errno != errno.EXDEV:
+                raise
+            shutil.copy2(filename, newname)
+            filename.unlink()
         logger.info(f'renamed to {newname}')
 
 
