+    def perform_admission_test(self, seed_path):
+
+        mmio_trace_path = os.path.join(self.base_dir, "admission_mmio_trace.bin")
+        seed_size = os.path.getsize(seed_path)
+
+        instruction_limit = 3000000
+        extra_args = ["-l", str(instruction_limit), "-v", "--mmio-trace-out", mmio_trace_path, "--fuzz-consumption-timeout", "0"]
+        cmd = gen_run_arglist(self.base_config_path, extra_args) + [seed_path]
+
+        try:
+            result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
+            stdout = result.stdout
+            exit_code = result.returncode
+        except subprocess.TimeoutExpired:
+            if os.path.exists(mmio_trace_path):
+                os.remove(mmio_trace_path)
+            return False, "TIMEOUT", "Execution exceeded physical time limit (120s)"
+
+        is_main_limit_reached = f"Ran into instruction limit of {instruction_limit}" in stdout
+
+        total_consumed = 0
+        if os.path.exists(mmio_trace_path):
+            try:
+                trace_entries = parse_mmio_trace(mmio_trace_path)
+                total_consumed = sum(entry[6] for entry in trace_entries)
+            except Exception:
+                pass
+            finally:
+                os.remove(mmio_trace_path)
+
+        if "Execution failed with error code" in stdout or "Emulation crashed" in stdout or (exit_code != 0 and not is_main_limit_reached):
+            crash_info = "Unknown Crash"
+            detail_match = re.search(r"\(?(\d+: .*?\(UC_ERR_[A-Z_]+\))\)?", stdout)
+            if detail_match:
+                extracted_info = detail_match.group(1)
+                crash_info = "Discovery phase failed" if "UC_ERR_OK" in extracted_info else extracted_info
+            elif "Execution failed with error code" in stdout:
+                try:
+                    crash_info = stdout.split("Execution failed with error code:")[1].split("\n")[0].strip()
+                except:
+                    crash_info = "Harness error"
+            elif exit_code < 0:
+                import signal
+                try:
+                    crash_info = f"OS_SIGNAL_{signal.Signals(-exit_code).name}"
+                except:
+                    crash_info = f"OS_SIGNAL_{abs(exit_code)}"
+            
+            return False, "CRASH", crash_info
+        if is_main_limit_reached:
+            if total_consumed > 0:
+                return True, "NORMAL_LIMIT_REACHED", f"Reached {instruction_limit} limit with {total_consumed} bytes consumed"
+            else:
+                return False, "HANG", f"Reached {instruction_limit} limit with ZERO consumption"
+        if exit_code == 0:
+            if total_consumed >= seed_size:
+                return True, "NORMAL_FULL_CONSUMPTION", f"Consumed all {seed_size} bytes"
+            else:
+                return False, "INCOMPLETE_CONSUMPTION", f"Exited normally but only consumed {total_consumed}/{seed_size} bytes"
+
+        return False, "UNKNOWN", "Did not match any criteria"
+
