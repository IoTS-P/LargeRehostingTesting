{
  "metadata": {
    "description": "Stage 2 Emulation \u2014 Admission, matching the reference server: FuzzwareGateway generates the fuzzware configuration, then the three admission tests record per-firmware seed verdicts in fuzzware_admission_checks_v2 / hoedur_admission_checks_v2 / multifuzz_admission_checks_v2 (result, detail). The eligibility constraint is the server's (base_address IS NOT NULL AND entry_valid = 'valid'). The patched fuzzware pipeline runs the admission test right after it parses its configuration and then exits (`sys.exit(1)` for a failing seed, `sys.exit(0)` for a passing one), so this stage is a check and never a fuzzing run: 6.8 s for the fixture here, 17.7 s on average over the reference server's 2,468 samples.",
    "startCommand": "nohup ./bin/akiba_framework -c /data/pipelines/02b_admission.json@/main > /data/results/logs/02b_admission.log 2>&1 &",
    "constraint": "WHERE id IN (SELECT id FROM firmxray_results WHERE base_address IS NOT NULL AND entry_valid = 'valid')"
  },
  "main": {
    "username": "akiba",
    "password": "akiba",
    "usingInstance": "akiba-instance",
    "general": {
      "binariesRoot": "/data/akiba/binaries",
      "importRoot": "/",
      "processor": "n/a",
      "autoAnalysisTimeout": 180,
      "threads": 32
    },
    "withGhidraProject": {
      "projectRoot": "/data/akiba/ghidra_projects",
      "name": "00b_analyze",
      "mode": "fork",
      "forkTo": "02b_admission",
      "continueLog": "02b_admission",
      "overwriteProject": true,
      "overwriteLog": true,
      "saveProject": true,
      "noCreateProgram": false
    },
    "sqlSource": {
      "serverIP": "127.0.0.1",
      "serverPort": "31777",
      "useSnapshot": "current",
      "constraint": "WHERE id IN (SELECT id FROM firmxray_results WHERE base_address IS NOT NULL AND entry_valid = 'valid')",
      "disableUpdate": false
    },
    "dbImports": [
      "firmxray_results.base_address"
    ],
    "tasks": [
      {
        "mainClassName": "org.iotsplab.akiba.process.FuzzwareGateway",
        "configKey": "@@/FuzzwareGateway",
        "consoleLogLevel": "debug",
        "fileLogLevel": "debug"
      },
      {
        "mainClassName": "org.iotsplab.akiba.process.FuzzwareAdmissionTest",
        "configKey": "@@/FuzzwareAdmissionTest",
        "tableName": "fuzzware_admission_checks_v2",
        "consoleLogLevel": "debug",
        "fileLogLevel": "debug"
      },
      {
        "mainClassName": "org.iotsplab.akiba.process.HoedurAdmissionTest",
        "configKey": "@@/HoedurAdmissionTest",
        "tableName": "hoedur_admission_checks_v2",
        "consoleLogLevel": "debug",
        "fileLogLevel": "debug"
      },
      {
        "mainClassName": "org.iotsplab.akiba.process.MultiFuzzAdmissionTest",
        "configKey": "@@/MultiFuzzAdmissionTest",
        "tableName": "multifuzz_admission_checks_v2",
        "consoleLogLevel": "debug",
        "fileLogLevel": "debug"
      }
    ]
  },
  "FuzzwareGateway": {
    "cmdPrefix": [
      "/bin/zsh",
      "-ic"
    ],
    "cmdPredo": "source ~/.zshrc && source /usr/share/virtualenvwrapper/virtualenvwrapper.sh",
    "regenerateConfig": true,
    "projectRoot": "fuzzware_projects",
    "venv": "fuzzware_gdma"
  },
  "FuzzwareAdmissionTest": {
    "cmdPrefix": [
      "/bin/zsh",
      "-ic"
    ],
    "cmdPredo": "source ~/.zshrc && source /usr/share/virtualenvwrapper/virtualenvwrapper.sh && export FUZZWARE_ADMISSION_ONLY=1",
    "venv": "fuzzware_gdma",
    "projectRoot": "fuzzware_admission_test"
  },
  "HoedurAdmissionTest": {
    "cmdPrefix": [
      "/bin/zsh",
      "-ic"
    ],
    "cmdPredo": "source ~/.zshrc && source /usr/share/virtualenvwrapper/virtualenvwrapper.sh",
    "venv": "fuzzware_gdma",
    "projectRoot": "hoedur_admission_test",
    "hoedurRoot": "/data/tools/hoedur",
    "cargoPath": "/home/akiba/.cargo/bin/cargo",
    "baseAddressSource": "firmxray_results.base_address"
  },
  "MultiFuzzAdmissionTest": {
    "cmdPrefix": [
      "/bin/zsh",
      "-ic"
    ],
    "cmdPredo": "source ~/.zshrc && export MULTIFUZZ_ADMISSION_ONLY=1",
    "projectRoot": "multifuzz_admission_test",
    "multiFuzzRoot": "/data/tools/MultiFuzz",
    "cargoPath": "/home/akiba/.cargo/bin/cargo",
    "baseAddressSource": "firmxray_results.base_address"
  }
}
