{
  "metadata": {
    "description": "Second FirmRCA pass: classify the inputs that the first pass marked (classifiedMode=true, input list comes from the view firmrca_classified_replays). Same shape as 06_firmrca.json, only classifiedMode and dbImports differ \u2014 keep the two in sync.",
    "startCommand": "nohup ./bin/akiba_framework -c /data/pipelines/06b_firmrca_classify.json@/main > /data/results/logs/06b_firmrca_classify.log 2>&1 &",
    "constraint": "WHERE id IN (SELECT id FROM firmrca_classified_replays)"
  },
  "main": {
    "username": "akiba",
    "password": "akiba",
    "usingInstance": "akiba-instance",
    "general": {
      "binariesRoot": "/data/akiba/binaries",
      "importRoot": "/",
      "processor": "n/a",
      "autoAnalysisTimeout": 180,
      "threads": 1
    },
    "withGhidraProject": {
      "projectRoot": "/data/akiba/ghidra_projects",
      "name": "00b_analyze",
      "mode": "fork",
      "forkTo": "06b_firmrca_classify",
      "continueLog": "06b_firmrca_classify",
      "overwriteLog": true,
      "saveProject": true,
      "noCreateProgram": false
    },
    "sqlSource": {
      "serverIP": "127.0.0.1",
      "serverPort": "31777",
      "useSnapshot": "current",
      "constraint": "WHERE id IN (SELECT id FROM firmrca_classified_replays)",
      "disableUpdate": false
    },
    "dbImports": [
      "firmxray_results.base_address",
      "firmrca_classified_replays.paths"
    ],
    "tasks": [
      {
        "mainClassName": "org.iotsplab.akiba.process.FuzzwareGateway",
        "configKey": "@@/FuzzwareGateway",
        "consoleLogLevel": "debug",
        "fileLogLevel": "debug"
      },
      {
        "mainClassName": "org.iotsplab.akiba.process.FirmRCA",
        "configKey": "@@/FirmRCA",
        "tableName": "firmrca_classified_results",
        "consoleLogLevel": "debug",
        "fileLogLevel": "debug"
      }
    ]
  },
  "FuzzwareGateway": {
    "cmdPrefix": [
      "/bin/zsh",
      "-ic"
    ],
    "cmdPredo": "source ~/.zshrc && source /usr/share/virtualenvwrapper/virtualenvwrapper.sh",
    "regenerateConfig": true,
    "projectRoot": "fuzzware_projects",
    "venv": "fuzzware"
  },
  "FirmRCA": {
    "firmRCARoot": "/data/tools/FirmRCA",
    "firmRCAPythonVenvRoot": "/data/tools/FirmRCA/FirmRCA-fuzzware",
    "baseAddressSource": "firmxray_results.base_address",
    "classifySource": "firmrca_classified_replays.paths",
    "classifiedMode": true,
    "deleteLogOnFinish": true,
    "deleteAllFilesOnFinish": true,
    "timeoutForEach": 1800,
    "maximumInsn": 100000
  }
}
